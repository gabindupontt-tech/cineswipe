---
layout: base.njk
kind: article
pagination:
  data: contenu.articles
  size: 1
  alias: article
permalink: "{{ article.url }}"
eleventyComputed:
  title: "{{ article.titre }} | CinéSwipe"
  description: "{{ article.description }}"
---
{#
  GABARIT D'ARTICLE (8 éléments)
  1 bandeau de rubrique  2 titre, auteur, date  3 réponse directe en tête  4 intertitres H2 (et image avec texte alternatif)
  5 liens dans le texte  6 encadré newsletter (bénéfice nommé)  7 « À lire ensuite » (même rubrique d'abord)  8 pied de page du site
#}
{% set suite = [] %}
{% for a in contenu.articles %}{% if a.slug != article.slug and a.rubrique == article.rubrique %}{% set suite = (suite.push(a), suite) %}{% endif %}{% endfor %}
{% for a in contenu.articles %}{% if a.slug != article.slug and a.rubrique != article.rubrique and suite.length < 2 %}{% set suite = (suite.push(a), suite) %}{% endif %}{% endfor %}
<article class="section article">
  <div class="wrap wrap--narrow">
    <p class="article__rubrique"><a class="chip" href="{{ '/articles/#' + article.rubrique | url }}">{{ article.rubriqueNom }}</a></p>
    <h1>{{ article.titre }}</h1>
    <p class="caption article__meta">Par {{ article.auteur }} · {{ article.dateFr }} · {{ article.minutes }} min de lecture{% if article.enRelecture %} · <strong>version en relecture</strong>{% endif %}</p>

    <p class="article__reponse" id="reponse">{{ article.reponse }}</p>

    {% if article.illustration %}
    <figure class="article__figure"><img src="{{ ('/assets/img/' + article.illustration) | url }}" alt="{{ article.illustrationAlt }}" loading="lazy"></figure>
    {% endif %}

    <div class="prose article__corps">{{ article.html | safe }}</div>

    <section class="article__sources" aria-labelledby="sources-titre">
      <h2 id="sources-titre">Sources</h2>
      <ol class="sources">
        {% for s in article.sources %}<li value="{{ s.n }}">{{ s.nom }} : <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.url }}<span class="sr-only"> (s'ouvre dans un nouvel onglet)</span></a>{% if s.note %} ({{ s.note }}){% endif %}</li>
        {% endfor %}
      </ol>
    </section>
  </div>
</section>

{% include "newsletter.njk" %}

{% if suite.length %}
<section class="section" aria-labelledby="suite-titre">
  <div class="wrap wrap--narrow">
    <h2 id="suite-titre">À lire ensuite</h2>
    <ul class="archives">
      {% for a in suite %}<li><a class="week-link" href="{{ a.url | url }}"><span class="week-link__date">{{ a.titre }}</span><span class="caption">{{ a.rubriqueNom }} · {{ a.minutes }} min</span></a></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
